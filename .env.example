# ReceiptCSV Configuration Example
# Copy this file to .env and fill in your values

# OpenAI API Key for AI-powered processing
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-api-key-here

# Optional: OpenAI Model (default: gpt-3.5-turbo)
# Other options: gpt-4, gpt-4-turbo-preview
# OPENAI_MODEL=gpt-3.5-turbo

# Note: The system works without AI using traditional parsing
# AI is only needed for:
# - Noisy OCR output correction
# - Complex receipt formats
# - Intelligent discount type identification
